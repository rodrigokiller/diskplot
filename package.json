{
  "name": "diskplot",
  "version": "0.1.0",
  "description": "See what is filling your disk. A treemap and a tree, side by side.",
  "author": "Rodrigo Sanguanini",
  "license": "MIT",
  "homepage": "https://rodrigokiller.github.io/diskplot/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodrigokiller/diskplot.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/shared/*.test.ts src/main/*.test.ts",
    "icons": "electron scripts/make-icons.cjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --dir --publish never",
    "release": "node scripts/release.mjs",
    "site:deploy": "git subtree push --prefix site origin gh-pages"
  },
  "build": {
    "appId": "com.diskplot.app",
    "productName": "Diskplot",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rodrigokiller",
        "repo": "diskplot"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.2"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
